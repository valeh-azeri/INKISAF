<div class="oi-card">
    <div style="font-size:11px;font-weight:700;color:var(--ink-500);letter-spacing:0.03em;">@Label</div>
    <div class="heading" style="font-size:26px;color:var(--green-900);margin-top:6px;">@Value</div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div style="font-size:11.5px;color:var(--green-600);margin-top:4px;font-weight:600;">@Hint</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Hint { get; set; } = "";
}
