@page "/library"
@inject ApiClient Api
@inject NavigationManager Nav

<div class="oi-topbar" style="margin:-16px -16px 16px -16px;">
    <div class="title">Kitabxana</div>
</div>

<div style="display:flex;gap:8px;margin-bottom:14px;overflow-x:auto;">
    <FilterChip Label="Hamısı" Active="@(_filter == null)" OnClick='() => SetFilter(null)' />
    <FilterChip Label="Quran Kərim" Active="@(_filter == "Quran")" OnClick='() => SetFilter("Quran")' />
    <FilterChip Label="Ümumi" Active="@(_filter == "General")" OnClick='() => SetFilter("General")' />
</div>

@if (_loading)
{
    <div class="oi-spinner-center">Yüklənir...</div>
}
else if (_error is not null)
{
    <div class="oi-alert oi-alert-error">@_error</div>
}
else if (_books.Count == 0)
{
    <div class="oi-card" style="text-align:center;color:var(--ink-500);">Hələ kitab yoxdur.</div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:10px;">
        @foreach (var book in _books)
        {
            <div class="oi-card" style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;" @onclick='() => Nav.NavigateTo($"reader/{book.Id}")'>
                <div>
                    <div class="heading" style="font-size:15px;">@book.Title</div>
                    @if (!string.IsNullOrEmpty(book.Author))
                    {
                        <div style="font-size:12px;color:var(--ink-500);margin-top:2px;">@book.Author</div>
                    }
                    @if (book.CurrentUserPage.HasValue)
                    {
                        var pct = book.TotalPages > 0 ? (int)Math.Round(100.0 * book.CurrentUserPage.Value / book.TotalPages) : 0;
                        <div style="font-size:11.5px;color:var(--green-700);margin-top:4px;font-weight:600;">@(pct)% oxunub</div>
                    }
                </div>
                @if (book.CurrentUserCompleted == true)
                {
                    <span class="oi-badge">Bitirilib</span>
                }
                else if (book.Category == BookCategoryDto.Quran)
                {
                    <span class="oi-badge oi-badge-gold">Quran</span>
                }
            </div>
        }
    </div>
}

@code {
    private List<BookSummaryDto> _books = new();
    private bool _loading = true;
    private string? _error;
    private string? _filter;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetFilter(string? filter)
    {
        _filter = filter;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetBooksAsync(_filter);
            _books = result.ToList();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch
        {
            _error = "Kitablar yüklənə bilmədi.";
        }
        finally
        {
            _loading = false;
        }
    }
}
