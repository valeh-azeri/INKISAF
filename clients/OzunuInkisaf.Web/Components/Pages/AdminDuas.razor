@page "/admin/duas"
@layout AdminLayout
@inject ApiClient Api

<h2 class="heading" style="margin-bottom:18px;">Dualar</h2>

<div class="oi-two-col">
    <div class="oi-card">
        <div class="oi-section-title">@(_editingId is null ? "Yeni dua əlavə et" : "Duanı redaktə et")</div>
        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="oi-alert oi-alert-error">@_formError</div>
        }
        <div class="oi-field" style="margin-bottom:8px;">
            <input placeholder="Başlıq" @bind="_title" @bind:event="oninput" />
        </div>
        <div class="oi-field" style="margin-bottom:8px;">
            <select @bind="_category">
                <option value="Daily">Gündəlik</option>
                <option value="Travel">Səfər</option>
                <option value="Distress">Sıxıntı</option>
                <option value="Sleep">Yuxu</option>
                <option value="Other">Digər</option>
            </select>
        </div>

        <div style="font-size:11.5px;color:var(--ink-500);margin-bottom:6px;">
            Mətn yazın, PDF yükləyin, ya da hər ikisini birdən edin.
        </div>

        <div class="oi-field" style="margin-bottom:8px;align-items:flex-start;">
            <textarea rows="3" dir="rtl" placeholder="Ərəbcə mətn (opsional)" @bind="_arabicText" @bind:event="oninput" style="font-size:17px;"></textarea>
        </div>
        <div class="oi-field" style="margin-bottom:8px;align-items:flex-start;">
            <textarea rows="2" placeholder="Transliterasiya (opsional)" @bind="_transliteration" @bind:event="oninput"></textarea>
        </div>
        <div class="oi-field" style="margin-bottom:10px;align-items:flex-start;">
            <textarea rows="3" placeholder="Tərcümə (opsional)" @bind="_translation" @bind:event="oninput"></textarea>
        </div>

        <div style="margin-bottom:14px;">
            <label class="oi-btn oi-btn-outline oi-btn-block" style="cursor:pointer;">
                @(_pickedPdfName ?? (_editingId is not null && _editingHasPdf ? "PDF-i əvəz et (opsional)" : "PDF faylı əlavə et (opsional)"))
                <InputFile OnChange="OnPdfSelectedAsync" accept=".pdf" style="display:none;" />
            </label>
        </div>

        <button class="oi-btn oi-btn-primary oi-btn-block" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saxlanılır..." : _editingId is null ? "Dua əlavə et" : "Dəyişiklikləri yadda saxla")
        </button>
        @if (_editingId is not null)
        {
            <button class="oi-btn oi-btn-outline oi-btn-block" style="margin-top:8px;" @onclick="CancelEdit">Ləğv et</button>
        }
    </div>

    <div class="oi-card">
        <div class="oi-section-title">Bütün dualar (@_duas.Count)</div>
        @if (_actionError is not null)
        {
            <div class="oi-alert oi-alert-error">@_actionError</div>
        }
        @if (_loading)
        {
            <div class="oi-spinner-center">Yüklənir...</div>
        }
        else if (_loadError is not null)
        {
            <div class="oi-alert oi-alert-error">@_loadError</div>
        }
        else
        {
            <table class="oi-table">
                <thead>
                    <tr><th>Başlıq</th><th>Kateqoriya</th><th>PDF</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var dua in _duas)
                    {
                        <tr>
                            <td>@dua.Title</td>
                            <td>@CategoryLabel(dua.Category)</td>
                            <td>
                                @if (dua.HasPdf)
                                {
                                    <span class="oi-badge">Var</span>
                                }
                                else
                                {
                                    <span style="color:var(--ink-500);">—</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                <span class="oi-btn oi-btn-sm oi-btn-outline" @onclick="() => StartEdit(dua)">Redaktə et</span>
                                <span class="oi-btn oi-btn-sm oi-btn-outline" style="color:#A33A3A;border-color:#A33A3A;" @onclick="() => DeleteAsync(dua)">Sil</span>
                            </td>
                        </tr>
                    }
                    @if (_duas.Count == 0)
                    {
                        <tr><td colspan="4" style="text-align:center;color:var(--ink-500);">Hələ dua yoxdur.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const long MaxPdfSizeBytes = 50 * 1024 * 1024;

    private List<DuaDto> _duas = new();
    private bool _loading = true;
    private string? _loadError;
    private string? _actionError;

    private Guid? _editingId;
    private bool _editingHasPdf;
    private string _title = string.Empty;
    private string _category = "Daily";
    private string _arabicText = string.Empty;
    private string _transliteration = string.Empty;
    private string _translation = string.Empty;
    private MemoryStream? _pickedPdf;
    private string? _pickedPdfName;
    private bool _saving;
    private string? _formError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetDuasAsync();
            _duas = result.ToList();
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch
        {
            _loadError = "Dualar yüklənə bilmədi.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CategoryLabel(DuaCategoryDto category) => category switch
    {
        DuaCategoryDto.Daily => "Gündəlik",
        DuaCategoryDto.Travel => "Səfər",
        DuaCategoryDto.Distress => "Sıxıntı",
        DuaCategoryDto.Sleep => "Yuxu",
        _ => "Digər",
    };

    private async Task OnPdfSelectedAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxPdfSizeBytes))
            {
                await stream.CopyToAsync(buffer);
            }
            buffer.Position = 0;

            _pickedPdf = buffer;
            _pickedPdfName = file.Name;
        }
        catch
        {
            _formError = "Fayl seçilə bilmədi (50MB-dan böyük ola bilər).";
        }
    }

    private void StartEdit(DuaDto dua)
    {
        _editingId = dua.Id;
        _editingHasPdf = dua.HasPdf;
        _title = dua.Title;
        _category = dua.Category.ToString();
        _arabicText = dua.ArabicText ?? string.Empty;
        _transliteration = dua.Transliteration ?? string.Empty;
        _translation = dua.Translation ?? string.Empty;
        _pickedPdf = null;
        _pickedPdfName = null;
        _formError = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editingHasPdf = false;
        _title = string.Empty;
        _category = "Daily";
        _arabicText = string.Empty;
        _transliteration = string.Empty;
        _translation = string.Empty;
        _pickedPdf = null;
        _pickedPdfName = null;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _formError = "Duanın başlığı tələb olunur.";
            return;
        }

        var hasText = !string.IsNullOrWhiteSpace(_arabicText) || !string.IsNullOrWhiteSpace(_translation);
        var willHavePdf = _pickedPdf is not null || (_editingId is not null && _editingHasPdf);
        if (!hasText && !willHavePdf)
        {
            _formError = "Ya mətn yazın, ya da PDF faylı əlavə edin.";
            return;
        }

        var category = Enum.TryParse<DuaCategoryDto>(_category, out var parsed) ? parsed : DuaCategoryDto.Other;
        var request = new UpsertDuaRequest(
            _title.Trim(),
            string.IsNullOrWhiteSpace(_arabicText) ? null : _arabicText.Trim(),
            string.IsNullOrWhiteSpace(_translation) ? null : _translation.Trim(),
            string.IsNullOrWhiteSpace(_transliteration) ? null : _transliteration.Trim(),
            category);

        _saving = true;
        try
        {
            var dua = _editingId is null
                ? await Api.CreateDuaAsync(request)
                : await Api.UpdateDuaAsync(_editingId.Value, request);

            if (_pickedPdf is not null)
            {
                _pickedPdf.Position = 0;
                await Api.UploadDuaPdfAsync(dua.Id, _pickedPdf, _pickedPdfName!);
                await _pickedPdf.DisposeAsync();
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        catch
        {
            _formError = "Dua saxlanıla bilmədi.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(DuaDto dua)
    {
        _actionError = null;
        try
        {
            await Api.DeleteDuaAsync(dua.Id);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _actionError = ex.Message;
        }
        catch
        {
            _actionError = "Dua silinə bilmədi.";
        }
    }
}
