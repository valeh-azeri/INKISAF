@page "/profile"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="oi-topbar" style="margin:-16px -16px 16px -16px;">
    <div class="title">Profil</div>
</div>

<div class="oi-card" style="text-align:center;margin-bottom:14px;">
    <div style="width:56px;height:56px;border-radius:50%;background:var(--green-100);color:var(--green-800);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px;margin:0 auto 10px;">
        @Initials
    </div>
    <div class="heading" style="font-size:17px;">@Auth.FullName</div>
    <div style="font-size:12.5px;color:var(--ink-500);">@@@Auth.Username</div>
    @if (Auth.IsAdmin)
    {
        <div style="margin-top:10px;">
            <a href="/admin/dashboard" class="oi-btn oi-btn-outline oi-btn-sm">İdarə panelinə keç</a>
        </div>
    }
</div>

<div class="oi-card" style="margin-bottom:14px;">
    <div class="oi-section-title">Şifrəni dəyiş</div>
    @if (!string.IsNullOrEmpty(_pwError))
    {
        <div class="oi-alert oi-alert-error">@_pwError</div>
    }
    @if (_pwSuccess)
    {
        <div class="oi-alert oi-alert-success">Şifrə uğurla dəyişdirildi.</div>
    }
    <div class="oi-field" style="margin-bottom:8px;">
        <input type="password" placeholder="Cari şifrə" @bind="_currentPassword" @bind:event="oninput" />
    </div>
    <div class="oi-field" style="margin-bottom:10px;">
        <input type="password" placeholder="Yeni şifrə" @bind="_newPassword" @bind:event="oninput" />
    </div>
    <button class="oi-btn oi-btn-primary oi-btn-block" @onclick="ChangePasswordAsync" disabled="@_pwBusy">
        @(_pwBusy ? "Göndərilir..." : "Şifrəni yenilə")
    </button>
</div>

<button class="oi-btn oi-btn-outline oi-btn-block" @onclick="SignOut">Çıxış</button>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _pwError;
    private bool _pwSuccess;
    private bool _pwBusy;

    private string Initials => string.Concat((Auth.FullName ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpper(p[0])));

    private async Task ChangePasswordAsync()
    {
        _pwError = null;
        _pwSuccess = false;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _pwError = "Hər iki sahəni doldurun.";
            return;
        }

        _pwBusy = true;
        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            _pwSuccess = true;
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
        }
        catch (ApiException ex)
        {
            _pwError = ex.Message;
        }
        catch
        {
            _pwError = "Şifrə dəyişdirilə bilmədi.";
        }
        finally
        {
            _pwBusy = false;
        }
    }

    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login");
    }
}
